# Copy this file to .env and fill it in. Never commit .env.

# Sign-in for the dashboard at /admin. Use a long, unique password.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-long-password

# Port the server listens on (npm start / npm run dev)
PORT=3001

# Folder where reviews and booking requests are saved (db.json). Keep it on persistent storage and back it up.
DATA_DIR=data

# Set to 1 only when the server runs behind a reverse proxy (nginx, a hosting platform's load balancer)
# so the real visitor IP and https are detected.
TRUST_PROXY=0
